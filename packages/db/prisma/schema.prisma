generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  telegramUserId        String   @unique
  telegramUsername      String?
  telegramFirstName     String?
  telegramLastName      String?
  preferredLanguage     String   @default("pl")
  email                 String?  @unique
  emailVerifiedAt       DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  profile               UserProfile?
  fundingProfile        FundingProfile?
  notificationPreference NotificationPreference?
  cases                 Case[]
  notifications         Notification[]
  auditEvents           AuditEvent[]
  emailVerifications    EmailVerification[]
}

model UserProfile {
  id             String @id @default(cuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  voivodeship    String?
  county         String?
  municipality   String?
  city           String?
  postalCode     String?
  pupOfficeId    String?
  wupOfficeId    String?
  lgdId          String?
  regionVerified Boolean @default(false)
  regionSource   String?
}

model FundingProfile {
  id                            String @id @default(cuid())
  userId                        String @unique
  user                          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  employmentStatus              String?
  wantsToStartBusiness          Boolean?
  existingBusinessLegalForm    String?
  plannedLegalForm              String?
  plannedBusinessDescription    String?
  plannedPkd                    String[] @default([])
  businessActiveLast12Months    Boolean?
  priorNonRepayableStartupAid   Boolean?
  wantsPfronPath                Boolean @default(false)
  updatedAt                     DateTime @updatedAt
}

model NotificationPreference {
  id                 String  @id @default(cuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  morningDigest      Boolean @default(true)
  criticalAlerts     Boolean @default(true)
  newCalls           Boolean @default(true)
  legalChanges       Boolean @default(true)
  caseChanges        Boolean @default(true)
  marketing          Boolean @default(false)
  telegramWriteAccess Boolean @default(false)
}

model Institution {
  id           String @id @default(cuid())
  code         String @unique
  type         String
  name         String
  voivodeship  String?
  county       String?
  municipality String?
  officialUrl  String
  sources      Source[]
  calls        FundingCall[]
  assignments  RegionAssignment[]
}

model RegionAssignment {
  id             String @id @default(cuid())
  voivodeship    String
  county         String?
  municipality   String?
  city           String?
  postalCodeFrom String?
  postalCodeTo   String?
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  role           String
  validFrom      DateTime?
  validTo        DateTime?
  sourceUrl      String
  verifiedAt     DateTime
  @@index([voivodeship, county, municipality, city])
}

model Source {
  id            String   @id @default(cuid())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  kind          String
  canonicalUrl  String   @unique
  trustLevel    String
  enabled       Boolean  @default(true)
  checkedAt     DateTime?
  contentHash   String?
  etag          String?
  lastModified  String?
  lastStatusCode Int?
  scopeVoivodeship String?
  scopeCounty      String?
  scopeMunicipality String?
  documents     SourceDocument[]
}

model SourceDocument {
  id            String   @id @default(cuid())
  sourceId      String
  source        Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  originalName  String
  mimeType      String
  sha256        String
  storageKey    String
  publishedAt   DateTime?
  validFrom     DateTime?
  validTo       DateTime?
  downloadedAt  DateTime @default(now())
  formTemplates OfficialFormTemplate[]
  @@unique([sourceId, sha256])
}

model OfficialFormTemplate {
  id               String   @id @default(cuid())
  sourceDocumentId String
  sourceDocument   SourceDocument @relation(fields: [sourceDocumentId], references: [id])
  institutionId    String?
  programCode      String?
  formCode         String
  versionLabel     String?
  active           Boolean @default(true)
  officialOnly     Boolean @default(true)
  fieldMappings    FormFieldMapping[]
  @@index([institutionId, programCode, active])
}

model FormFieldMapping {
  id         String @id @default(cuid())
  templateId String
  template   OfficialFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey   String
  sourcePath String
  inputType  String
  required   Boolean @default(false)
  helpText   String?
  @@unique([templateId, fieldKey])
}

model FundingCall {
  id             String   @id @default(cuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  title          String
  programCode    String?
  status         String
  opensAt        DateTime?
  closesAt       DateTime?
  untilExhausted Boolean  @default(false)
  officialUrl    String?
  verifiedAt     DateTime?
  cases          Case[]
  @@index([status, opensAt, closesAt])
}

model Case {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String
  caseType           String
  fundingCallId      String?
  fundingCall        FundingCall? @relation(fields: [fundingCallId], references: [id])
  legalSnapshotId    String?
  formTemplateId     String?
  submittedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  answers            CaseAnswer[]
  documents          CaseDocument[]
  @@index([userId, status])
}

model CaseAnswer {
  id        String @id @default(cuid())
  caseId    String
  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fieldKey  String
  valueJson Json
  version   Int @default(1)
  @@unique([caseId, fieldKey, version])
}

model CaseDocument {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type           String
  storageKey     String
  officialSource Boolean  @default(false)
  templateHash   String?
  createdAt      DateTime @default(now())
}

model ChangeEvent {
  id            String   @id @default(cuid())
  sourceId      String?
  changeType    String
  severity      String
  detectedAt    DateTime @default(now())
  effectiveFrom DateTime?
  summary       String
  verified      Boolean @default(false)
  verificationScore Int?
  payload       Json?
  @@index([severity, verified, detectedAt])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String
  priority      String
  title         String
  body          String
  scheduledAt   DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  changeEventId String?
  dedupeKey     String?
  @@index([userId, scheduledAt, sentAt])
  @@unique([userId, dedupeKey])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorType String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId, createdAt])
}


model EmailVerification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  @@index([userId, email, createdAt])
}
