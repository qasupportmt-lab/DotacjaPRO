generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  telegramUserId        String   @unique
  telegramUsername      String?
  telegramFirstName     String?
  telegramLastName      String?
  preferredLanguage     String   @default("pl")
  email                 String?  @unique
  emailVerifiedAt       DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  profile               UserProfile?
  fundingProfile        FundingProfile?
  notificationPreference NotificationPreference?
  cases                 Case[]
  notifications         Notification[]
  auditEvents           AuditEvent[]
  emailVerifications    EmailVerification[]
}

model UserProfile {
  id             String @id @default(cuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  voivodeship    String?
  county         String?
  municipality   String?
  city           String?
  postalCode     String?
  pupOfficeId    String?
  wupOfficeId    String?
  lgdId          String?
  regionVerified Boolean @default(false)
  regionSource   String?
  terytMunicipalityCode String?
  terytLocalityCode     String?
  terytVerified         Boolean @default(false)
  terytVerifiedAt       DateTime?
}

model FundingProfile {
  id                            String @id @default(cuid())
  userId                        String @unique
  user                          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  employmentStatus              String?
  wantsToStartBusiness          Boolean?
  existingBusinessLegalForm    String?
  plannedLegalForm              String?
  plannedBusinessDescription    String?
  plannedPkd                    String[] @default([])
  businessActiveLast12Months    Boolean?
  priorNonRepayableStartupAid   Boolean?
  wantsPfronPath                Boolean @default(false)
  updatedAt                     DateTime @updatedAt
}

model NotificationPreference {
  id                 String  @id @default(cuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  morningDigest      Boolean @default(true)
  criticalAlerts     Boolean @default(true)
  newCalls           Boolean @default(true)
  legalChanges       Boolean @default(true)
  caseChanges        Boolean @default(true)
  marketing          Boolean @default(false)
  telegramWriteAccess Boolean @default(false)
}

model Institution {
  id           String @id @default(cuid())
  code         String @unique
  type         String
  name         String
  voivodeship  String?
  county       String?
  municipality String?
  officialUrl  String
  sources      Source[]
  calls        FundingCall[]
  assignments  RegionAssignment[]
  criterionSets LocalCriterionSet[]
}

model RegionAssignment {
  id             String @id @default(cuid())
  voivodeship    String
  county         String?
  municipality   String?
  city           String?
  postalCodeFrom String?
  postalCodeTo   String?
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  role           String
  validFrom      DateTime?
  validTo        DateTime?
  sourceUrl      String
  verifiedAt     DateTime
  @@index([voivodeship, county, municipality, city])
  @@unique([institutionId, role, voivodeship, municipality])
}

model Source {
  id            String   @id @default(cuid())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  kind          String
  canonicalUrl  String   @unique
  displayName   String?
  discoveredFromUrl String?
  trustLevel    String
  enabled       Boolean  @default(true)
  checkedAt     DateTime?
  contentHash   String?
  etag          String?
  lastModified  String?
  lastStatusCode Int?
  scopeVoivodeship String?
  scopeCounty      String?
  scopeMunicipality String?
  documents     SourceDocument[]
  fundingCalls   FundingCall[]
  @@index([institutionId])
}

model SourceDocument {
  id            String   @id @default(cuid())
  sourceId      String
  source        Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  originalName  String
  mimeType      String
  sha256        String
  storageKey    String
  publishedAt   DateTime?
  validFrom     DateTime?
  validTo       DateTime?
  downloadedAt  DateTime @default(now())
  formTemplates OfficialFormTemplate[]
  criterionSets LocalCriterionSet[]
  @@unique([sourceId, sha256])
}

model OfficialFormTemplate {
  id               String   @id @default(cuid())
  sourceDocumentId String
  sourceDocument   SourceDocument @relation(fields: [sourceDocumentId], references: [id])
  institutionId    String?
  programCode      String?
  formCode         String
  versionLabel     String?
  active           Boolean @default(true)
  officialOnly     Boolean @default(true)
  requiredForPackage Boolean @default(true)
  mappingStatus    String  @default("UNMAPPED")
  mappingVerifiedAt DateTime?
  mappingAnalyzedAt DateTime?
  mappingAnalysisJson Json?
  mappingAnalysisError String?
  mappingVersion   Int     @default(1)
  fieldMappings    FormFieldMapping[]
  renderJobs       DocumentRenderJob[]
  fundingCallId    String?
  fundingCall      FundingCall? @relation(fields: [fundingCallId], references: [id], onDelete: SetNull)
  @@index([institutionId, programCode, active])
  @@index([fundingCallId, active])
  @@index([sourceDocumentId])
}

model FormFieldMapping {
  id         String @id @default(cuid())
  templateId String
  template   OfficialFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey      String
  sourcePath    String
  locatorType   String
  locatorJson   Json?
  inputType     String
  questionLabel String?
  section       String?
  sortOrder     Int     @default(0)
  required      Boolean @default(false)
  helpText      String?
  validationJson Json?
  @@unique([templateId, fieldKey])
}

model FundingCall {
  id                 String   @id @default(cuid())
  institutionId      String
  institution        Institution @relation(fields: [institutionId], references: [id])
  sourceId           String?  @unique
  source             Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  title              String
  programCode        String?
  status             String
  opensAt            DateTime?
  closesAt           DateTime?
  untilExhausted     Boolean  @default(false)
  officialUrl        String?
  verificationStatus String   @default("DISCOVERED")
  evidenceJson       Json?
  sourceHash         String?
  discoveredAt       DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  verifiedAt         DateTime?
  cases              Case[]
  criterionSets       LocalCriterionSet[]
  formTemplates       OfficialFormTemplate[]
  submissionInstructions SubmissionInstructionVersion[]
  @@index([status, opensAt, closesAt])
  @@index([verificationStatus, verifiedAt])
  @@index([institutionId])
}

model Case {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String
  caseType           String
  fundingCallId      String?
  fundingCall        FundingCall? @relation(fields: [fundingCallId], references: [id])
  legalSnapshotId    String?
  formTemplateId     String?
  submittedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  answers            CaseAnswer[]
  documents          CaseDocument[]
  renderJobs          DocumentRenderJob[]
  qualifications      QualificationSnapshot[]
  criterionAssessments CriterionAssessmentSnapshot[]
  packageJobs          DocumentPackageJob[]
  @@index([userId, status])
  @@index([fundingCallId])
}

model CaseAnswer {
  id        String @id @default(cuid())
  caseId    String
  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fieldKey  String
  valueJson Json
  version   Int @default(1)
  @@unique([caseId, fieldKey, version])
}

model CaseDocument {
  id               String   @id @default(cuid())
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type             String
  originalName     String?
  mimeType         String?
  storageKey       String
  officialSource   Boolean  @default(false)
  templateHash     String?
  sourceDocumentId String?
  renderJobId      String?  @unique
  createdAt        DateTime @default(now())
  @@index([caseId])
}

model ChangeEvent {
  id            String   @id @default(cuid())
  sourceId      String?
  changeType    String
  severity      String
  detectedAt    DateTime @default(now())
  effectiveFrom DateTime?
  summary       String
  verified      Boolean @default(false)
  verificationScore Int?
  verifiedAt    DateTime?
  requalificationProcessedAt DateTime?
  payload       Json?
  @@index([severity, verified, detectedAt])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String
  priority      String
  title         String
  body          String
  scheduledAt   DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  changeEventId String?
  dedupeKey     String?
  @@index([userId, scheduledAt, sentAt])
  @@unique([userId, dedupeKey])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorType String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId, createdAt])
  @@index([userId])
}


model EmailVerification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  @@index([userId, email, createdAt])
}


model DocumentRenderJob {
  id               String   @id @default(cuid())
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  templateId       String
  template         OfficialFormTemplate @relation(fields: [templateId], references: [id])
  status           String   @default("QUEUED")
  outputStorageKey String?
  outputSha256     String?
  outputMimeType   String?
  outputName       String?
  errorCode        String?
  errorMessage     String?
  requestedAt      DateTime @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  @@index([status, requestedAt])
  @@index([caseId, templateId])
  @@index([templateId])
}


model TerytMunicipality {
  id                   String   @id @default(cuid())
  tercCode              String   @unique
  voivodeshipCode       String
  voivodeship           String
  countyCode            String?
  county                String?
  municipalityCode      String?
  municipality          String
  municipalityTypeCode  String?
  municipalityType      String?
  validFrom              DateTime?
  validTo                DateTime?
  sourceKind             String   @default("TERYT_WS1")
  sourceUpdatedAt        DateTime
  sourceVersion          String?
  localities             TerytLocality[]
  @@index([voivodeship, municipality])
  @@index([county, municipality])
}

model TerytLocality {
  id                   String   @id @default(cuid())
  simcCode             String   @unique
  name                 String
  localityType         String?
  municipalityTercCode String
  municipality         TerytMunicipality @relation(fields: [municipalityTercCode], references: [tercCode], onDelete: Cascade)
  sourceUpdatedAt      DateTime
  sourceVersion        String?
  @@index([name, municipalityTercCode])
  @@index([municipalityTercCode])
}

model QualificationSnapshot {
  id            String   @id @default(cuid())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status        String
  engineVersion String
  resultJson    Json
  sourceRefs    Json?
  createdAt     DateTime @default(now())
  @@index([caseId, createdAt])
}


model LocalCriterionSet {
  id               String   @id @default(cuid())
  institutionId    String
  institution      Institution @relation(fields: [institutionId], references: [id])
  fundingCallId    String?
  fundingCall      FundingCall? @relation(fields: [fundingCallId], references: [id], onDelete: SetNull)
  sourceDocumentId String   @unique
  sourceDocument   SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  title            String
  status           String   @default("DRAFT")
  minimumPoints    Float?
  maximumPoints    Float?
  blockingRulesJson Json?
  analysisJson     Json?
  sourceHash       String
  version          Int      @default(1)
  analyzedAt       DateTime?
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  criteria         LocalCriterion[]
  assessments      CriterionAssessmentSnapshot[]
  @@index([institutionId, status, verifiedAt])
  @@index([fundingCallId, status])
}

model LocalCriterion {
  id               String   @id @default(cuid())
  criterionSetId   String
  criterionSet     LocalCriterionSet @relation(fields: [criterionSetId], references: [id], onDelete: Cascade)
  code             String
  category         String?
  title            String
  description      String?
  maxPoints        Float?
  failIfZero       Boolean  @default(false)
  scoringJson      Json?
  evidenceHint     String?
  sortOrder        Int      @default(0)
  @@unique([criterionSetId, code])
  @@index([criterionSetId, sortOrder])
}


model CriterionAssessmentSnapshot {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  criterionSetId String
  criterionSet   LocalCriterionSet @relation(fields: [criterionSetId], references: [id], onDelete: Cascade)
  status         String
  answersJson    Json
  resultJson     Json
  createdAt      DateTime @default(now())
  @@index([caseId, createdAt])
  @@index([criterionSetId, createdAt])
}


model SubmissionInstructionVersion {
  id            String   @id @default(cuid())
  fundingCallId String
  fundingCall   FundingCall @relation(fields: [fundingCallId], references: [id], onDelete: Cascade)
  version       Int      @default(1)
  status        String   @default("DRAFT")
  instructionJson Json
  sourceUrl     String
  sourceHash    String?
  analyzedAt    DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  packageJobs   DocumentPackageJob[]
  @@index([fundingCallId, status, verifiedAt])
}

model DocumentPackageJob {
  id                      String   @id @default(cuid())
  caseId                  String
  case                    Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  submissionInstructionId String
  submissionInstruction   SubmissionInstructionVersion @relation(fields: [submissionInstructionId], references: [id])
  status                  String   @default("QUEUED")
  recipientEmail          String
  outputStorageKey        String?
  outputSha256            String?
  outputName              String?
  errorCode               String?
  errorMessage            String?
  requestedAt             DateTime @default(now())
  startedAt               DateTime?
  completedAt             DateTime?
  @@index([status, requestedAt])
  @@index([caseId, requestedAt])
  @@index([submissionInstructionId])
}


model StoredObject {
  id         String   @id @default(cuid())
  storageKey String   @unique
  mimeType   String
  sha256     String
  sizeBytes  Int
  content    Bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([sha256])
  @@index([createdAt])
}
