{
  "name": "dotacjapro",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "start:api": "pnpm --filter @dotacjapro/db db:generate && pnpm --filter @dotacjapro/api exec tsx src/index.ts",
    "start:bot": "pnpm --filter @dotacjapro/bot exec tsx src/index.ts",
    "generate:db": "pnpm --filter @dotacjapro/db db:generate"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  }
}
