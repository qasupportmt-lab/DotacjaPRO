NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DotacjaPRO_bot
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram numeric user IDs allowed to review/verify sources.
# Server-side only. Never expose this value to NEXT_PUBLIC_* variables.
ADMIN_TELEGRAM_USER_IDS=

DATABASE_URL=postgresql://dotacjapro:dotacjapro@localhost:5432/dotacjapro
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=dotacjapro
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

MAIL_FROM=
MAIL_PROVIDER_API_KEY=

INTERNAL_WORKER_SECRET=replace-with-long-random-worker-secret
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=
DOCUMENT_SIGNING_SECRET=

EMAIL_VERIFICATION_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DotacjaPRO <no-reply@example.com>

# Optional official GUS TERYT full-file endpoints.
# When both are configured, update-engine refreshes the local TERC/SIMC cache daily.
TERYT_TERC_FULL_URL=
TERYT_SIMC_FULL_URL=

# Optional ws1 credentials for a future direct SOAP adapter.
TERYT_WS1_USERNAME=
TERYT_WS1_PASSWORD=

# Final package delivery.
MAX_EMAIL_ATTACHMENT_BYTES=15728640
PACKAGE_LINK_EXPIRES_SECONDS=86400
