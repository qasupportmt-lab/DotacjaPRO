# Production values belong in hosting secret stores. Do not commit real secrets.

NODE_ENV=production

# Public URLs
APP_BASE_URL=https://miniapp.example
API_BASE_URL=https://api.example
PUBLIC_API_BASE_URL=https://api.example
NEXT_PUBLIC_API_BASE_URL=https://api.example

# PostgreSQL / Supabase
DATABASE_URL=postgresql://APP_ROLE:SECRET@HOST:5432/postgres?sslmode=require

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DotacjaPRO_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://bot.example/webhook
ADMIN_TELEGRAM_USER_IDS=

# Internal service authentication
INTERNAL_WORKER_SECRET=
APP_SESSION_SECRET=
EMAIL_VERIFICATION_SECRET=
DOCUMENT_SIGNING_SECRET=
CRON_SECRET=

# Storage
OBJECT_STORAGE_MODE=api

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DotacjaPRO <no-reply@example.com>

# TERYT optional automatic channels
TERYT_TERC_FULL_URL=
TERYT_SIMC_FULL_URL=
TERYT_WS1_USERNAME=
TERYT_WS1_PASSWORD=

# Runtime modes
ENABLE_BACKGROUND_SCHEDULER=true
ENABLE_BACKGROUND_WORKER=true

